# ============================================
# Frame TV Art Generator - Configuration
# ============================================
# Copy this file to config.yaml and customize:
#   cp config.yaml.example config.yaml

# --- Image Generation Settings ---
image:
  # Choose any fal.ai text-to-image endpoint that accepts `prompt` and
  # returns an `images` list. Find model IDs at https://fal.ai/models.
  fal:
    model: "fal-ai/nano-banana-2"
    # These arguments are passed directly to the selected model. Check that
    # model's fal.ai API page because supported arguments differ by model.
    arguments:
      aspect_ratio: "16:9"
      resolution: "4K"
      num_images: 1
      output_format: "jpeg"
      limit_generations: true

  # Output settings applied after fal.ai generation
  output:
    width: 3840                  # Samsung Frame TV native width
    height: 2160                 # Samsung Frame TV native height
    format: "JPEG"
    jpeg_quality: 95

# Optional prompt engineering (prepended/appended to user's description)
prompt_prefix: "Professional art suitable for display on a wall. "
prompt_suffix: " High resolution, vivid colors, suitable for home decor."

# --- Samsung Frame TVs ---
# Add each TV with a unique key, its IP address, and room aliases
tvs:
  living_room:
    host: "192.168.1.100"
    port: 8002
    token_file: "tokens/living_room_token.txt"
    aliases:
      - "living room"
      - "lounge"
      - "main tv"
    matte: "none"                # matte style: none, modern_apricot, etc.

  bedroom:
    host: "192.168.1.101"
    port: 8002
    token_file: "tokens/bedroom_token.txt"
    aliases:
      - "bedroom"
      - "master bedroom"
    matte: "none"
