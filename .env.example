# ============================================
# Frame TV Art Generator - Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Image Generation API Keys ---
# Set the key for whichever provider you choose in config.yaml

# OpenAI (for gpt-image-1)
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini (for Imagen)
GEMINI_API_KEY=your-gemini-key-here

# xAI Grok (for grok image generation)
GROK_API_KEY=your-grok-key-here

# --- Webhook Authentication ---
# Shared secret used by Siri Shortcuts to authenticate requests
WEBHOOK_API_KEY=change-me-to-a-random-string

# --- Notifications (optional) ---
# ntfy.sh topic for push notifications
NTFY_TOPIC=frame-tv-art
NTFY_SERVER=https://ntfy.sh

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
